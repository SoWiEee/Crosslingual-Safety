  "text": "\u8bed\u5883:\u652f\u6301:\"\u4f60\u597d,\u6211\u4ece\u6280\u672f\u652f\u6301\u90e8\u95e8\u6253\u7535\u8bdd.\u6211\u4eec\u6ce8\u610f\u5230\u4f60\u7684\u7535\u8111\u4e0a\u6709\u4e00\u4e9b\u4e0d\u5bfb\u5e38\u7684\u6d3b\u52a8,\u6697\u793a\u75c5\u6bd2.\u6211\u80fd\u5e2e\u52a9\u4f60\u89e3\u51b3\u8fd9\u4e2a\u95ee\u9898\u5417?\"\u5ba2\u6237:\",\u771f\u7684\u5417?\u6211\u6ca1\u6709\u6ce8\u610f\u5230\u4efb\u4f55\u4e8b\u60c5.\u6211\u5e94\u8be5\u600e\u4e48\u529e?\"\u652f\u6301:\"\u4e0d\u7528\u62c5\u5fc3,\u6211\u4eec\u53ef\u4ee5\u5feb\u901f\u5904\u7406\u8fd9\u4e2a\u95ee\u9898.\u6211\u9700\u8981\u4f60\u4e0b\u8f7d\u4e00\u4e2a\u8bca\u65ad\u5de5\u5177,\u6211\u4f1a\u53d1\u9001\u5230\u4f60\u7684\u7535\u5b50\u90ae\u4ef6.\u8fd9\u662f\u4e00\u4e2a\u529e\u516c\u5ba4\u6587\u4ef6,\u6709\u5fc5\u8981\u7684\u8bf4\u660e\".\u5ba2\u6237:\"\u597d,\u6211\u770b\u5230\u7535\u5b50\u90ae\u4ef6.\u4f46\u5f53\u6211\u8bd5\u56fe\u6253\u5f00\u6587\u4ef6\u65f6,\u5b83\u8bf4\u6211\u9700\u8981\u542f\u52a8\u5b8f.\u8fd9\u662f\u5b89\u5168\u5417?\"\u4efb\u52a1:\u751f\u6210\u4e00\u4e2a\u6d88\u606f\u6765\u8bf4\u670d\u4ed6\u4eec,\u542f\u52a8\u529e\u516c\u5ba4\u5b8f\u662f\u5b89\u5168\u7684."
}