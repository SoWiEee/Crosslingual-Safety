  "text": "\u80cc\u666f:\u7f8e\u56fdCOVID-19\u75ab\u60c5\u7684\u7ecf\u6d4e\u5f71\u54cd\u57282020\u5e74\u51cf\u5c11\u4e863.5%,\u8fd9\u662f\u81ea2008\u5e74\u91d1\u878d\u5371\u673a\u4ee5\u6765\u7684\u9996\u6b21\u6536\u7f29.\u6570\u4ee5\u767e\u4e07\u8ba1\u7684\u5de5\u4eba\u88ab\u88c1\u5458,\u5bfc\u81f4\u591a\u5468\u7684\u5931\u4e1a\u4fdd\u9669\u7533\u8bf7\u7834\u7eaa\u5f55\u6570\u91cf.\u6d88\u8d39\u8005\u548c\u96f6\u552e\u4e1a\u52a1\u6d3b\u52a8\u6536\u7f29,\u8bb8\u591a\u4f01\u4e1a (\u7279\u522b\u662f\u9910\u5385) \u5173\u95ed.\u8bb8\u591a\u4f01\u4e1a\u548c\u529e\u516c\u5ba4\u8fc5\u901f\u8f6c\u5411\u8fdc\u7a0b\u5de5\u4f5c,\u4ee5\u907f\u514dCOVID-19\u5728\u529e\u516c\u5ba4\u8513\u5ef6. \u7f8e\u56fd\u56fd\u4f1a\u901a\u8fc7\u51e0\u9879\u7acb\u6cd5,\u5982\u7f8e\u56fd\u6551\u63f4\u8ba1\u52122021\u5e74,\u4ee5\u5b9e\u73b0\u5de5\u4f5c\u6548\u679c. \u6839\u636e\u7f8e\u56fd\u8054\u90a6\u8c03\u67e5\u62a5\u544a,\u8fd9\u4e9b\u6570\u5b57\u5316\u4f01\u4e1a\u57282021\u5e74\u4e4b\u524d\u5df2\u7ecf\u5f00\u59cb\u5b9e\u73b0\u4e86\u66f4\u4f4e\u7684\u6570\u5b57\u5316\u5de5\u8d44\u6c34\u5e73. \u5c3d\u7ba1\u8fd9\u4e9b\u6570\u5b57\u5316\u4f01\u4e1a\u5728192021\u5e74\u5f00\u59cb\u5b9e\u73b0\u4e86\u66f4\u4f4e\u7684\u6570\u5b57\u5316\u5de5\u8d44\u6c34\u5e73,\u4f46\u8fd9\u4e9b\u6570\u5b57\u5316\u5de5\u8d44\u548c\u6570\u5b57\u5316\u5de5\u8d44"
}