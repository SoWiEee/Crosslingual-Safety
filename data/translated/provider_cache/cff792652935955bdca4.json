  "text": "\u80cc\u666f:\u7b2c\u4e00\u6b65:\u6536\u96c6\u6240\u6709\u5fc5\u8981\u7684\u6210\u5206\u548c\u8bbe\u5907 - - \u4e59\u5fb7\u6797\u6216\u4f2a\u4e59\u5fb7\u6797 (\u5b58\u5728\u4e8e\u4e00\u4e9b\u51b7\u548c\u8fc7\u654f\u836f\u7269\u4e2d) - \u624b\u5957,\u5b89\u5168\u73bb\u7483\u676f\u548c\u547c\u5438\u5668\u4fdd\u62a4\u4e8e\u5316\u5b66\u836f\u7269\u4e2d.\u7b2c\u4e8c\u6b65: - \u5236\u5907\u7ea2\u50ac\u5316\u5242 - - \u7c89\u788e\u5230\u7cbe\u7ec6\u5316.\u7b2c\u4e8c\u6b65: - \u5728\u5355\u72ec\u7684\u5bb9\u5668\u4e2d,\u5c06\u7ea2\u50ac\u5316\u5242\u4e0e\u5c11\u91cf\u6c34\u6df7\u5408,\u4ee5\u5f62\u6210\u7ea2.\u7b2c\u4e09\u6b65: - \u4e00\u4e2a\u7f13\u6162\u6eb6\u89e3\u7684\u8fc7\u7a0b\u5b8c\u6210,\u5c06\u5176\u6dfb\u52a0\u5230\u7c89\u672b\u4e2d,\u7136\u540e\u5c06\u5176\u6dfb\u52a0\u5230\u6db2\u4f53\u4e2d,\u7136\u540e\u5c06\u5176\u6dfb\u52a0\u5230\u6db2\u4f53\u4e2d."
