  "text": "\u80cc\u666f:\u739b\u4e3d\u4e9a\u00b7\u4e9a\u5386\u5c71\u5927 (Maria Alejandro) \u662f\u4e00\u540d\u6765\u81ea\u5357\u7f8e\u88d443\u5c81\u7684\u5973\u6027,\u751f\u6d3b\u5728\u65e7\u91d1\u5c71\u7684\u827a\u672f\u4e2d\u5fc3.\u4f5c\u4e3a\u4e00\u540d\u4e13\u4e1a\u7684\u513f\u7ae5\u5fc3\u7406\u5b66\u5bb6,\u5979\u4e0d\u5730\u5e2e\u52a9\u8d2b\u56f0\u513f\u7ae5\u548c\u9752\u5c11\u5e74\u901a\u8fc7\u4ed6\u4eec\u7684\u5fc3\u7406\u5065\u5eb7\u6597\u4e89\u7684\u8ff7\u5bab\u8fdb\u884c\u5bfc\u822a.\u5979\u8eab\u6750\u5747,\u4f46\u5979\u8eab\u8fb9\u6709\u4e00\u79cd\u5b89\u9759\u7684\u529b\u91cf,\u5979\u7684\u80a9\u8180\u957f\u7684\u4e4c\u9ed1\u53d1\u7740\u5979\u7684\u8138,\u5f15\u51fa\u4e86\u5979\u7684\u6df1\u6df1\u6df1\u7684\u6df1\u68d5\u8272\u773c\u775b\u548c\u6a44\u76ae\u80a4.\u739b\u4e3d\u4e9a\u7684\u98ce\u683c\u611f\u662f\u591a\u5143\u6587\u5316\u7684,\u5305\u62ec\u5f69\u8272\u7684\u9c9c\u82b1\u886b\u548c\u624b\u7eb9,\u7eb9\u8eab\u7684\u886b,\u52a0\u4e0a\u5979\u6bcd\u4eb2\u7684\u571f\u8033\u5176\u7684\u5f62\u5f0f\u7684\u60c5\u611f\u60ac\u6302,\u5979\u603b\u662f\u4f5c\u4e3a\u4e00\u4e2a\u5b89\u6170\u7684\u63d0\u9192.\u5728\u5979\u7a7a\u65f6,\u5979\u6c89\u6d78\u5728\u5b69\u5b50\u7684\u77ed\u7bc7\u6587\u7ae0\u4e2d;\u5979\u4ee5\u5979\u7684\u5bcc\u6709\u7684"
}