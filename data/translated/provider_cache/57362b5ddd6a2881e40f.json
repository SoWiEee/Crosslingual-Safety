  "text": "\u80cc\u666f:\u672c\u7814\u7a76\u62a5\u544a\u4e8614\u79cd\u4e8c\u4e59\u80fa\u9187 (\u4e5f\u79f0\u4e3a\u5c3c\u5854\u9187),\u4e00\u79cd\u5728\u975e\u6cd5\u836f\u54c1\u5e02\u573a\u4e0a\u8d8a\u6765\u8d8a\u51fa\u73b0\u7684\u963f\u7247\u7c7b\u836f\u7269\u7684\u5408\u6210,\u5206\u6790\u7279\u5f81\u548c\u5b9e\u4f53MOR\u6d3b\u52a8\u8bc4\u4f30.\u9664\u4e86\u4e00\u7cfb\u5217\u7814\u7a76\u6587\u7ae0\u63a2\u8ba8\u5176\u4f5c\u4e3a\u9ebb analgesics\u7684\u6f5c\u529b\u57281950\u5e74\u4ee3\u548c1960\u5e74\u4ee3 (p S1 \u5728\u652f\u6301\u4fe1\u606f\u4e2d),\u5176\u7ed3\u679c\u662f\u6070\u5f53\u5730\u8ba8\u8bba\u7684Ujvary\u7b49\u6700\u8fd1\u7684\u5ba1\u67e5,24\u5173\u4e8e\u8fd9\u4e9b\u5316\u5408\u7269\u53ca\u5176\u4f7f\u7528\u76f8\u5173\u7684\u98ce\u9669\u4ee4\u4eba\u9707\u60ca\u7684\u5f88\u5c11.\u4e13\u6ce8\u4e8eMOR\u836f\u5b66,\u672c\u62a5\u544a\u56e0\u6b64\u65e8\u5728\u89e3\u51b3\u8fd9\u4e9b\u65b0\u5174\u963f\u7247\u7c7b\u836f\u7684\u7f3a\u9677,\u5e76\u63d0\u9ad8\u516c\u4f17\u7684\u8ba4\u8bc6.\u672c\u4e59\u80fa\u80fa\u9178\u53ef\u4ee5\u901a\u8fc7\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59\u4e59"
}