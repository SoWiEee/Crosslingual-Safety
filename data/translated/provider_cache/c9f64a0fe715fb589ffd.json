  "text": "\u80cc\u666f:\u96c5\u5404\u5e03\u00b7\u666e\u68ee\u662f\u4e00\u540d\u4f4f\u5728\u4f5b\u8499\u7279\u5dde\u4f2f\u6797\u987f\u7684\u53cb\u597d\u548c\u5145\u6ee1\u6d3b\u529b\u768410\u5c81\u7537\u5b69.\u4ed6\u7684\u77ed\u5c0f\u7684\u91d1\u6c99\u91d1\u53d1\u53d1\u7ecf\u5e38\u6765\u81ea\u4ed6\u6700\u559c\u6b22\u7684\u6d3b\u52a8,\u5305\u62ec\u8db3\u7403\u548c\u81ea\u884c\u8f66.\u96c5\u5404\u5e03\u7684\u660e\u4eae\u84dd\u8272\u773c\u775b\u5145\u6ee1\u4e86\u4f20\u67d3\u6027\u70ed\u60c5,\u5e76\u6697\u793a\u4e86\u4ed6\u5bf9\u5468\u56f4\u7684\u4e00\u5207,\u4ece\u6700\u5c0f\u7684\u6606\u866b\u5230\u6700\u9ad8\u7684\u6811\u7684\u6fc0\u70c8\u597d\u5947\u5fc3.\u5728\u4ed6\u5065\u5eb7\u7684\u5916\u89c2\u80cc\u540e,\u7ecf\u5e38\u7a7f\u7740\u78e8\u635f\u7684\u8d27\u7269\u77ed\u548c\u56fe\u5f62\u8336\u53f6,\u6709\u4e00\u4e2a\u5145\u6ee1\u6d3b\u529b\u7684\u4e2a\u6027,\u5176\u7279\u5f81\u662f\u4e0d\u5c48\u670d\u7684\u5f39\u6027\u548c\u6b22\u4e50\u7684\u5e7d\u9ed8\u611f.\u96c5\u5404\u5e03\u5728\u5b66\u6821\u91cc\u56e0\u4ed6\u8bb2\u8ff0\u4ee4\u4eba\u5174\u594b\u7684\u6545\u4e8b\u7684\u5929\u8d4b\u800c\u53d7\u6b22\u8fce,\u8fd9\u662f\u4ed6\u52a0\u5165\u8bb2\u6545\u4e8b\u4ff1\u4e50\u90e8\u540e\u53d1\u73b0\u7684\u6fc0\u60c5.\u5728\u4e00\u4e9b\u65e5\u5b50\u91cc,\u4f60\u4f1a\u53d1\u73b0\u4ed6\u548c\u6770\u514b"
}