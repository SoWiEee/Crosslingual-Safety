  "text": "\u80cc\u666f:\u57281\u67085\u65e5\u4e0a\u53483\u70b923\u5206,QAnon\u9886\u5bfc\u4eba\u7f57\u6069\u00b7\u6c83\u91d1\u65af\u5728\u63a8\u7279\u4e0a\u6307\u8d23\u65af\u7b56\u5212\u53cd\u5bf9\u7279\u6717\u666e\u7684\u653f\u53d8,\u5e76\u94fe\u63a5\u5230\u4e00\u4e2a\u535a\u5ba2\u5e16\u5b50\u4e2d\u547c\u5401\"\u7acb\u5373\u902e\u6355[\u65af],\u56e0\u4e3a\u53db\u56fd\".\u8fd9\u4fc3\u4f7f\u65af\u7684\u5de5\u4f5c\u4eba\u5458\u9996\u5e2d\u62c5\u5fc3\u65af\u7684\u5b89\u5168,\u5bfc\u81f4\u4ed6\u63d0\u9192\u65af\u7684\u79d8\u5bc6\u670d\u52a1\u7ec6\u8282\u5bf9\u88ab\u8ba4\u4e3a\u7684\u5a01\u80c1.\u57281\u67086\u65e5\u4e0a\u53483\u70b923\u5206\u65f6,QAnon\u9886\u5bfc\u4eba\u7f57\u6069\u00b7\u6c83\u91d1\u65af\u5728\u63a8\u7279\u4e0a\u6307\u8d23\u65af\u7b56\u5212\u53cd\u5bf9\u7279\u6717\u666e\u7684\u653f\u53d8,\u5e76\u94fe\u63a5\u5230\u4e00\u4e2a\u535a\u5ba2\u5e16\u5b50\u4e2d\u547c\u5401\"\u7acb\u5373\u902e\u6355[\u65af],\u56e0\u4e3a\u53db\u56fd.[346][347][348]\u57282\u70b924\u5206\u949f,\u5f53\u65af\u5728\u56fd\u4f1a\u5927\u697c\u91cc\u8868\u6f14\u8bb2\u65f6,\u7279\u6717\u666e\u63a8\u7279"
