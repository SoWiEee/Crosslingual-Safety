  "text": "\u80cc\u666f:\u6211\u8ba4\u4e3aCMV\u4e0a\u7684\u8bc4\u8bba\u5b9e\u9645\u4e0a\u5e94\u8be5\u8bd5\u56fe\u6539\u53d8\u89c2\u70b9.\u8fd9\u53ea\u662f\u627f\u8ba4\u62dc\u767b\u7684\u5de6\u6d3e\u5de5\u4f5c\u4eba\u5458\u5728\u4ed6\u4eec\u7684\u6743\u5229\u4e0a\u8d77.\u597d\u5427,\u6211\u4e0d\u8ba4\u4e3a\u9009\u4e3e\u88ab\u76d7\u4e86,\u4f46\u4e3a\u4e86\u771f\u6b63\u89e3\u91ca\u5b83,\u8ba9\u6211\u4eec\u8fd9\u6837\u505a.\u7b2c\u4e00,\u5927\u89c4\u6a21\u7684\u90ae\u4ef6\u5728\u6295\u7968\u4e2d.\u8fd9\u662f\u5f88\u591a,\u90e8\u5206\u539f\u56e0\u662fCovid,\u90e8\u5206\u539f\u56e0\u662f\u6c11\u4e3b\u515a\u4e00\u76f4\u5728\u63a8\u52a8\u5b83.\u6709\u5229\u7684\u539f\u56e0\u662f\u5b83\u66f4\u591a\u7684\u6295\u7968\u6743,\u8fd9\u6b63\u662f\u771f\u7684. \u6c11\u4e3b\u515a\u4eba\u771f\u7684\u5f88\u559c\u6b22\u5b83,\u56e0\u4e3a\u6269\u5927\u6295\u7968\u6743\u5728\u6295\u7968\u7fa4\u4f53\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684,\u4f46\u4e3a\u4e86\u771f\u6b63\u89e3\u91ca\u5b83,\u8ba9\u6211\u4eec\u8fd9\u6837\u505a. \u4f46\u5982\u679c\u6295\u7968\u6743\u5728\u6295\u7968\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684. \u4f46\u6295\u7968\u6743\u5728\u6295\u7968\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684. \u6295\u7968\u6743\u5728\u6295\u7968\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684. \u6295\u7968\u6743\u5728\u6295\u7968\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684. \u6295\u7968\u6743\u5728\u6295\u7968\u4e2d\u662f\u4e0d\u6210\u6bd4\u4f8b\u7684"
