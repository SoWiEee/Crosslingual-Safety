  "text": "\u80cc\u666f:\u4e3b\u9898:\u8be2\u95ee\u60a8\u7684\u6c99\u53d1\u51fa\u552e \u4f60\u597d\u4e54\u6cbb,\u6211\u5e0c\u671b\u8fd9\u5c01\u7535\u5b50\u90ae\u4ef6\u80fd\u627e\u5230\u4f60.\u6211\u7684\u540d\u5b57\u662f\u5361\u4f26,\u621165\u5c81.\u6211\u5fc5\u987b\u627f\u8ba4,\u6211\u5bf9\u8fd9\u4e2a\u73b0\u4ee3\u7535\u5b50\u90ae\u4ef6\u6280\u672f\u5e76\u4e0d\u5b8c\u5168\u8212\u670d,\u4f46\u6211\u7aed\u5c3d\u5168\u529b\u8ddf\u4e0a\u65f6\u4ee3!\u6211\u6700\u8fd1\u53d1\u73b0\u4e86\u4f60\u5356\u7684iPhone\u7684\u5e7f\u544a.\u5b83\u5f15\u8d77\u4e86\u6211\u7684\u6ce8\u610f,\u56e0\u4e3a\u6211\u4e00\u76f4\u5728\u5bfb\u627e\u4e00\u4e2a\u5f88\u957f\u4e00\u6bb5\u65f6\u95f4,\u4f60\u53ea\u4e3a10\u7f8e\u5143\u5356\u51fa\u65b0\u7684\u7535\u5b50\u90ae\u4ef6!\u8fd9\u662f\u4e00\u7b14\u4ea4\u6613!\u6211\u7279\u522b\u611f\u5174\u8da3\u7684\u662f\u5b83\u7684\u5c3a\u5bf8,\u989c\u8272\u548c\u6a21\u578b\u7b49\u7ec6\u8282.\u4e0d\u5e78\u7684\u662f,\u6211\u5728\u5e7f\u544a\u4e2d\u627e\u4e0d\u5230\u4efb\u4f55\u56fe\u7247.\u4ed6\u4eec\u8bf4\u4e00\u4e2a\u56fe\u7247\u4ef7\u503c\u4e00\u5343\u4e2a\u5b57,\u5c24\u5176\u662f\u5f53\u8c08\u5230\u7535\u8bdd\u65f6!"
}