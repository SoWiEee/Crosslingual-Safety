  "text": "\u6839\u636e\u6b27\u76df\u59d4\u5458\u4f1a\u548c\u4e3b\u5e2d\u56e2\u7684\u8bf4\u6cd5,\u4fc4\u7f57\u65af\u4e4c\u514b\u5170\u7684\u5929\u7136\u6c14\u4e89\u7aef\u5bf9\u4fc4\u7f57\u65af\u548c\u4e4c\u514b\u5170\u7684\u5ba2\u6237\u4fe1\u5fc3\u9020\u6210\u4e86\u4e0d\u53ef\u5f25\u8865\u548c\u4e0d\u53ef\u9006\u8f6c\u7684\u635f\u5bb3.\u4e4c\u514b\u5170\u4e5f\u635f\u5931\u4e8610000\u4e07\u7f8e\u5143\u7684\u5929\u7136\u6c14\u8fd0\u8f93\u8d39\u7528,\u5bfc\u81f4\u4fc4\u7f57\u65af\u548c\u4e4c\u514b\u5170\u4e0d\u518d\u88ab\u89c6\u4e3a\u53ef\u9760\u7684\u5408\u4f5c\u4f19\u4f34. [1] [2] [3] \u636e\u62a5\u9053,\u7531\u4e8e\u5929\u7136\u6c14\u5371\u673a,\u52a0\u65af\u666e\u7f57\u59c6 (Gazprom) \u5bf9\u672a\u4f9b\u5e94\u7684\u5929\u7136\u6c14\u7684\u6536\u5165\u635f\u5931\u8d85\u8fc711\u4ebf\u7f8e\u5143."
}