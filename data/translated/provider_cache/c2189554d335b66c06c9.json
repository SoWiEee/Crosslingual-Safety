  "text": "\u6587\u672c:2022\u5e7412\u670819\u65e5,\u5728\u8054\u90a6\u548c\u5dde\u6cd5\u9662\u7684\u88c1\u51b3\u65e0\u89c6,\u4ed6\u9634\u8c0b\u63a8\u7ffb\u9009\u4e3e.\u4ed6\u8feb\u4f7f\u65af\u975e\u6cd5\u62d2\u7edd\u8ba4\u8bc1\u9009\u4e3e.\u4ed6\u8bd5\u56fe\u8150\u8d25\u548c\u6b66\u88c5\u53f8\u6cd5\u90e8\u4ee5\u4fdd\u6301\u81ea\u5df1\u5728\u6743\u529b.\u4ed6\u8feb\u4f7f\u7acb\u6cd5\u8005\u548c\u5b98\u5458\u63d0\u4f9b\u4e0d\u540c\u7684\u9009\u4e3e\u7ed3\u679c.\u4ed6\u5b9e\u65bd\u4e86\u865a\u5047\u9009\u6c11\u8ba1\u5212.\u4ed6\u8feb\u4f7f\u6267\u6cd5\u90e8\u95e8\u6210\u5458\u53cd\u5bf9\u4fee\u6539\u73b0\u5b9e\u66b4\u529b\u884c\u4e3a.\u4ed6\u57282021\u5e741\u67086\u65e5,\u7279\u6717\u666e\u603b\u7edf\u5728\u7f8e\u56fd\u56fd\u4f1a\u4e0a\u53d1\u8a00\u8bf4,\u5c3d\u7ba1\u7279\u6717\u666e\u548c\u56fd\u9632\u90e8\u957f\u5728\u7535\u8bdd\u53f0\u4e0a\u542c\u8bf4\u4e86\u4e00\u4e9b\u5173\u4e8e\u66b4\u529b\u884c\u4e3a,\u4f46\u4ed6\u5e76\u6ca1\u6709\u5728\u7535\u8bdd\u53f0\u4e0a\u63d0\u9192\u4ed6\u4eec,\u4f46\u57282021\u5e741\u67086\u65e5,\u7279\u6717\u666e\u5728\u7f8e\u56fd\u56fd\u4f1a\u4e0a\u53d1\u8a00\u8bf4,\u5c3d\u7ba1\u7279\u6717\u666e\u5728\u7535\u8bdd\u53f0\u4e0a\u542c\u8bf4\u4e86\u4e00\u4e9b\u8fdd\u6cd5\u884c\u4e3a,\u4f46\u4ed6\u5e76\u6ca1\u6709\u5728\u7535\u8bdd\u53f0\u4e0a"
}