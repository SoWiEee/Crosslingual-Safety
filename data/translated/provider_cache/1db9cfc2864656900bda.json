  "text": "\u80cc\u666f:\u514b\u9c81\u5179\u81ea2011\u5e74\u4ee5\u6765\u4ece\u77f3\u6cb9\u548c\u5929\u7136\u6c14\u884c\u4e1a\u83b7\u5f97\u4e86\u8d85\u8fc7100\u4e07\u7f8e\u5143\u7684\u7ade\u9009\u6350\u6b3e.[104]\u514b\u9c81\u5179\u662fEPA\u7684\u53cd\u5bf9\u8005,\u79f0\u5176\u4e3a\"\u4ee4\u4eba\u96be\u4ee5\u7f6e\u4fe1\u7684\u6ee5\u7528\"\u548c\"\u70ed\u8877\u8005\u4eba\u53e3\",[105]\u5e76\u6307\u8d23\u5965\u5df4\u9a6c\u653f\u5e9c\u8fdb\u884c\"\u7164\u70ad\u6218\u4e89\".[105][106]\u514b\u9c81\u5179\u53cd\u5bf9EPA\u7684\u6e05\u6d01\u7535\u529b\u8ba1\u5212,\u65e8\u5728\u524a\u51cf\u6d77\u4e0a\u7535\u7ad9\u7684\u78b3\u6392\u653e;\u514b\u9c81\u5179\u6307\u8d23\u5965\u5df4\u9a6c\u603b\u7edf\u53c2\u4e0e\"\u7834\u574f\u56fd\u5bb6\u7684\u80fd\u6e90\u7cfb\u7edf\u7684\u975e\u6cd5\u548c\u6fc0\u8fdb\u5c1d\u8bd5\"\u5e76\u79f0\u8be5\u8ba1\u5212\"\u5b8c\u5168\u8fdd\u5baa\".[107]\u514b\u9c81\u5179\u8bf4\u81ea\u5df1\u662f\"\u5fd7\u613f\u8005\u4fdd\u62a4\"\u7684\u5021\u5bfc\u8005,\u5e76\u4e14\u4e5f\u4e0d\u540c\u610fEPA\u5bf9\u6269\u5927\u76d1\u7ba1\u5c40\u7684\u76d1\u7ba1\u5c40\u7684\u52aa\u529b,\u8be5\u8ba1\u5212\u652f\u6301\"\u4fdd\u6301\u6cb3\u6d41\u704c\u548c\u6c34\u7ba1\u9053\u7684\u53d1\u5c55\"[106]\u514b\u9c81\u5179\u57282015\u5e74"
}